# Copy this file to .env and fill in real values. Never commit .env.

# Required for AI list parsing
ANTHROPIC_API_KEY=sk-ant-api03-xxxxxxxx

# Required for Stripe Checkout
STRIPE_SECRET_KEY=sk_test_xxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxx

# Required for order confirmation emails
RESEND_API_KEY=re_xxxxxxxx
OWNER_EMAIL=owner@fasttrackschoolsupplies.com
FROM_EMAIL=orders@fasttrackschoolsupplies.com

# Admin dashboard credentials (set to something secure before deploy)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-to-something-secure

# Public URL of the deployed site (used in Stripe redirect URLs)
# Local dev: http://localhost:3001
# Production: https://yourdomain.com
BASE_URL=http://localhost:3001

# Optional. Defaults to 3001.
PORT=3001
